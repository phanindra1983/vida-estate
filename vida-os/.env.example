DATABASE_URL="file:./dev.db"
# Long random string for signing logins, e.g. from: openssl rand -base64 32
AUTH_SECRET=""
WEBSITE_URL="http://localhost:4400"
PUBLIC_OS_URL="http://localhost:3100"
CRON_KEY=""
DEMO_MODE="true"

# ── Email (Gmail or Google Workspace) ──
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
# 16-letter Google app password (never your normal password):
SMTP_PASS=""
MAIL_FROM=""
# Test mode: every email goes here instead of to vendors. Delete this line to go live.
MAIL_TEST_TO=""
# Supplier replies are read from the same mailbox over IMAP (defaults to Gmail).
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"

# Telegram voice notes: speech to text (Sarvam AI, https://indus.sarvam.ai). Added by the owner.
SARVAM_API_KEY=""

# Meta Lead Ads, direct webhook (optional; Zapier/Make with the META key works without these). Added by the owner.
META_APP_SECRET=""
META_PAGE_TOKEN=""

# AI caller (bolna.ai). The MD signs up; only the API key goes here. Agent id and webhook key live in the Setting table.
BOLNA_API_KEY=
