{
  "name": "vida-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "db:push": "prisma db push && node prisma/triggers.mjs",
    "db:seed": "node prisma/seed.mjs",
    "db:reset": "echo 'Online database: use db:push then db:seed on an empty database' && exit 1",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:copy-from-sqlite": "prisma generate --schema prisma/sqlite/schema.prisma && node prisma/copy-from-sqlite.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "3.0.3",
    "jose": "6.2.15",
    "next": "15.5.28",
    "nodemailer": "7.0.13",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
