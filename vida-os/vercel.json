{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/procurement",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/digest?kind=morning",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/digest?kind=evening",
      "schedule": "30 13 * * *"
    }
  ]
}
